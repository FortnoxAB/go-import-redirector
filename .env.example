# SSH configuration for git ls-remote probing (optional).
# By default the service uses the system SSH config (~/.ssh/config or $HOME/.ssh/).
# Override the SSH command to use a specific key:
# GIT_SSH_COMMAND=ssh -i /path/to/deploy-key -o BatchMode=yes -o StrictHostKeyChecking=accept-new

# Enable verbose logging by setting VERBOSE=1
#VERBOSE=1

# Path to the JSON config file (see redirects.example.json), read at startup.
# Must match wherever you actually mount/copy the file inside the container.
CONFIG=/redirects.json
