# Option 1: Personal access token (fine-grained, Metadata: Read-only permission)
# GITHUB_TOKEN=your-token-here

# Option 2: GitHub App (recommended — no expiry, auto-refreshed tokens)
# Requires "Repository permissions → Metadata: Read-only" installed on each probed org.
# Installation is discovered automatically per org — no installation ID needed.
# GITHUB_APP_ID=123456
# GITHUB_APP_PRIVATE_KEY_FILE=/path/to/private-key.pem
# GITHUB_APP_PRIVATE_KEY=<PEM contents>  # alternative to the file path above
